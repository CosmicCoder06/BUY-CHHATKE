# ─────────────────────────────────────────────────────────────────
# buySmarty — ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────

# Port Configuration
PORT=3000

# RapidAPI / Amazon Data API Key (Optional: Mock data fallback used if omitted)
RAPIDAPI_KEY=

# ─── REAL EMAIL VERIFICATION CONFIGURATION (NODEMAILER) ──────────
# Option 1: Gmail SMTP (Recommended & Easiest)
# 1. Enable 2-Step Verification in your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate a 16-character App Password for 'Mail'
# 4. Paste your Gmail address and 16-character App Password below:
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option 2: Generic Custom SMTP (Brevo / SendGrid / Mailgun / AWS SES)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="buySmarty <no-reply@buychhatke.ai>"
