{
  "manifest_version": 3,
  "name": "buySmartly — AI Shopping Assistant & Price Tracker",
  "version": "1.1.0",
  "description": "Real-time price history graph, fake discount detector & deal advisor for Flipkart, Amazon India, Myntra, Meesho & Ajio.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "buySmartly AI Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "*://*.flipkart.com/*",
    "*://*.myntra.com/*",
    "*://*.meesho.com/*",
    "*://*.ajio.com/*",
    "*://*.croma.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.amazon.com/*",
        "*://*.flipkart.com/*",
        "*://*.myntra.com/*",
        "*://*.meesho.com/*",
        "*://*.ajio.com/*"
        ,"*://*.croma.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "auth-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
